# NON committare i valori reali. Crea il Secret con: scripts/k8s-secrets.sh (legge web/.env.production)
apiVersion: v1
kind: Secret
metadata:
  name: dglm-web-env
  namespace: dglm
type: Opaque
stringData:
  RESEND_API_KEY: "re_xxx"
  MAIL_FROM: "DGLM <noreply@dglm.it>"
  MAIL_TO: "hello@dglm.it"
  ADMIN_PASSWORD: "cambiami"
  SESSION_SECRET: "openssl rand -hex 32"
  NEXT_PUBLIC_SITE_URL: "https://dglm.it"
